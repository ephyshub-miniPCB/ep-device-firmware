# Writes OUT_FILE defining EP_BUILD_VERSION as `git describe` of SRC_DIR's repo,
# with "-dirty" appended if anything under SRC_DIR (tracked or untracked, minus
# .gitignore'd files) differs from HEAD. Run on every build by the
# ep_build_version target in CMakeLists.txt; the header is only rewritten when
# the string changes, so unchanged builds don't recompile anything.

find_package(Git QUIET)

set(version "unknown")
if(GIT_FOUND)
  execute_process(
    COMMAND ${GIT_EXECUTABLE} describe --abbrev=12 --always
    WORKING_DIRECTORY ${SRC_DIR}
    OUTPUT_VARIABLE describe
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
    RESULT_VARIABLE describe_ret
  )
  if(describe_ret EQUAL 0)
    set(version ${describe})

    # only changes to the ep_device firmware itself count, not the rest of the repo
    execute_process(
      COMMAND ${GIT_EXECUTABLE} status --porcelain -- .
      WORKING_DIRECTORY ${SRC_DIR}
      OUTPUT_VARIABLE status
      ERROR_QUIET
    )
    if(NOT "${status}" STREQUAL "")
      string(APPEND version "-dirty")
    endif()
  endif()
endif()

set(content "/* Generated by cmake/ep_version.cmake, do not edit. */\n#define EP_BUILD_VERSION \"${version}\"\n")

if(EXISTS ${OUT_FILE})
  file(READ ${OUT_FILE} old_content)
endif()
if(NOT "${content}" STREQUAL "${old_content}")
  file(WRITE ${OUT_FILE} "${content}")
endif()
